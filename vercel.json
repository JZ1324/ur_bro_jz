{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/garden/:path*", "destination": "/api/garden/[...path]" }
  ],
  "functions": {
    "api/garden/[...path].ts": { "maxDuration": 60 }
  }
}
