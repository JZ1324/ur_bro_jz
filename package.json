    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts src/**/*.test.tsx tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build:server": "esbuild server/serve.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/serve.mjs",
    "db:setup": "node --import tsx scripts/setup-hosted-garden.mjs",
    "db:import": "node --import tsx scripts/import-hosted-garden.mjs"
