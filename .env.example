# Supabase project URL. Used to call:
# https://<project-ref>.supabase.co/functions/v1/get-private-archive
VITE_SUPABASE_URL="https://uajpewjagduzdpwlynrv.supabase.co"

# Optional explicit Edge Function URL. If present, this takes precedence over VITE_SUPABASE_URL.
VITE_SUPABASE_FUNCTION_URL=""

# Garden account sign-in (server only). Defaults to the About Me project.
# GARDEN_SUPABASE_URL="https://uajpewjagduzdpwlynrv.supabase.co"
# GARDEN_PUBLISHABLE_KEY="your-project-publishable-key"
# GARDEN_PUBLIC_URL="https://your-garden.example.com"
# GARDEN_DATABASE="/persistent/path/plantings.sqlite"

# Hosted garden database: SERVER ONLY. Use the existing Supabase transaction pooler URI.
# GARDEN_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres"
# GARDEN_PUBLIC_URL="https://ur-bro-jz.vercel.app"
# Never prefix the database URI with VITE_: it must not reach browser bundles.
